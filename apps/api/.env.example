# ── Copy to apps/api/.env for local development. Never commit real secrets. ──

NODE_ENV=development
PORT=3000
# Origin of the web app (CORS allowlist, links in emails). Comma-separate several.
WEB_ORIGIN=http://localhost:4200

# Postgres from infrastructure/docker-compose.yml
DATABASE_URL=postgresql://studywidbuddy:studywidbuddy@localhost:5433/studywidbuddy?schema=public
# Used by the e2e tests only
TEST_DATABASE_URL=postgresql://studywidbuddy:studywidbuddy@localhost:5433/studywidbuddy_test?schema=public
# Scratch database for `npm run db:check` (detects schema/migration drift)
SHADOW_DATABASE_URL=postgresql://studywidbuddy:studywidbuddy@localhost:5433/studywidbuddy_shadow?schema=public

REDIS_URL=redis://localhost:6380
QUEUE_PREFIX=sb

# AI. Leave AI_PROVIDER=none to run without an LLM: AI features then say they're unavailable
# instead of producing fake output. For real interviews set AI_PROVIDER=anthropic and a key.
AI_PROVIDER=none
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
AI_MODEL_FAST=claude-haiku-5-5

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-to-a-long-random-string
ACCESS_TOKEN_TTL_SEC=900
REFRESH_TOKEN_TTL_DAYS=30

# Email. Leave SMTP_URL empty to log verification/reset links to the API console instead of sending.
# Gmail example (needs 2-Step Verification + an App Password; @ in the address becomes %40):
#   SMTP_URL=smtps://you%40gmail.com:your16charapppassword@smtp.gmail.com:465
#   MAIL_FROM="StudywidBuddy <you@gmail.com>"
# Test it: npm run mail:test -- you@example.com
SMTP_URL=
MAIL_FROM="StudywidBuddy <no-reply@studywidbuddy.local>"

# GitHub App (team repos, PR <-> task linking). Leave all empty to turn GitHub features off.
# See docs/GITHUB.md for creating the app. Keep the .pem key OUTSIDE the repository.
GITHUB_ORG=
GITHUB_APP_ID=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_APP_PRIVATE_KEY_PATH=
# Or paste the PEM itself (hosting): GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----
..."
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
# Local development only: a smee.io channel that relays GitHub webhooks to this machine.
GITHUB_WEBHOOK_PROXY_URL=
API_PUBLIC_URL=http://localhost:3000

# Optional: lets the AI Buddy follow lesson videos. Google's Gemini API transcribes public YouTube
# videos (once per lesson, stored). Without it, admins can paste transcripts instead.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
